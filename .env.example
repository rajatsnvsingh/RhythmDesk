# Copy to .env. Keep the token private. At least 24 random characters.
CURATOR_AUTH_REQUIRED=1
# Optional prebuilt release image; otherwise Compose builds locally.
# Use an image release containing the three-folder layout (next release: v0.1.1).
# CURATOR_IMAGE=ghcr.io/rajatsnvsingh/rhythmdesk:v0.1.1
CURATOR_UI_TOKEN=replace-with-a-long-random-secret-before-starting
# Example host paths: replace with your own directories, not container paths.
ATTIC_PATH=/srv/music/rhythm-attic
STAGING_PATH=/srv/music/rhythm-attic/staging
SOURCE_PATH=/srv/music/source
STATE_VOLUME=rhythm-desk-state
LIBRARY_PATH=/srv/music/rhythm-attic/library
UI_PORT=8765
WORKER_UID=10001
UI_UID=10002
PUBLISHER_UID=10003
CURATOR_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave disabled for local HTTP; enable only behind correctly configured HTTPS.
CURATOR_SECURE_COOKIE=0
